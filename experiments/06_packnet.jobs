# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/06_packnet.jobs

# PackNet baseline (Mallya & Lazebnik, 2018) on the three-task sequence, matched to consolidate-and-gate: the same
# PushCube checkpoint after task 1; each task keeps 25% of every weight matrix (largest free weights) and retrains
# them for the same number of updates as the gate's consolidation (500 after PushCube, 6000 after StackCube).

s0_A_packnet|$CVLA_RUNS/final/s0/A/stage.json|scripts/train_stage.py --task PushCube-v1 --init $CVLA_RUNS/final/s0/A --method packnet --packnet-prune --packnet-keep 0.25 --seed 0 --steps 500 --warmup 50 --final-tasks PushCube-v1 --eval-init --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/A_packnet
s0_B_packnet|$CVLA_RUNS/final/s0/A_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --steps 12000 --init $CVLA_RUNS/final/s0/A_packnet --method packnet --seed 0 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/B_packnet
s0_B_packnet_pruned|$CVLA_RUNS/final/s0/B_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --init $CVLA_RUNS/final/s0/B_packnet --method packnet --packnet-prune --packnet-keep 0.25 --seed 0 --steps 6000 --warmup 100 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/B_packnet_pruned
s0_C_packnet|$CVLA_RUNS/final/s0/B_packnet_pruned/stage.json|scripts/train_stage.py --task StackCubeGreenOnRed-v1 --n-train 900 --steps 12000 --final-tasks PushCube-v1 StackCube-v1 StackCubeGreenOnRed-v1 --init $CVLA_RUNS/final/s0/B_packnet_pruned --method packnet --seed 0 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/C_packnet

s1_A_packnet|$CVLA_RUNS/final/s1/A/stage.json|scripts/train_stage.py --task PushCube-v1 --init $CVLA_RUNS/final/s1/A --method packnet --packnet-prune --packnet-keep 0.25 --seed 1 --steps 500 --warmup 50 --final-tasks PushCube-v1 --eval-init --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/A_packnet
s1_B_packnet|$CVLA_RUNS/final/s1/A_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --steps 12000 --init $CVLA_RUNS/final/s1/A_packnet --method packnet --seed 1 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/B_packnet
s1_B_packnet_pruned|$CVLA_RUNS/final/s1/B_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --init $CVLA_RUNS/final/s1/B_packnet --method packnet --packnet-prune --packnet-keep 0.25 --seed 1 --steps 6000 --warmup 100 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/B_packnet_pruned
s1_C_packnet|$CVLA_RUNS/final/s1/B_packnet_pruned/stage.json|scripts/train_stage.py --task StackCubeGreenOnRed-v1 --n-train 900 --steps 12000 --final-tasks PushCube-v1 StackCube-v1 StackCubeGreenOnRed-v1 --init $CVLA_RUNS/final/s1/B_packnet_pruned --method packnet --seed 1 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/C_packnet

s2_A_packnet|$CVLA_RUNS/final/s2/A/stage.json|scripts/train_stage.py --task PushCube-v1 --init $CVLA_RUNS/final/s2/A --method packnet --packnet-prune --packnet-keep 0.25 --seed 2 --steps 500 --warmup 50 --final-tasks PushCube-v1 --eval-init --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s2/A_packnet
s2_B_packnet|$CVLA_RUNS/final/s2/A_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --steps 12000 --init $CVLA_RUNS/final/s2/A_packnet --method packnet --seed 2 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s2/B_packnet
s2_B_packnet_pruned|$CVLA_RUNS/final/s2/B_packnet/stage.json|scripts/train_stage.py --task StackCube-v1 --n-train 900 --init $CVLA_RUNS/final/s2/B_packnet --method packnet --packnet-prune --packnet-keep 0.25 --seed 2 --steps 6000 --warmup 100 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s2/B_packnet_pruned
s2_C_packnet|$CVLA_RUNS/final/s2/B_packnet_pruned/stage.json|scripts/train_stage.py --task StackCubeGreenOnRed-v1 --n-train 900 --steps 12000 --final-tasks PushCube-v1 StackCube-v1 StackCubeGreenOnRed-v1 --init $CVLA_RUNS/final/s2/B_packnet_pruned --method packnet --seed 2 --eval-every 100000 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s2/C_packnet
