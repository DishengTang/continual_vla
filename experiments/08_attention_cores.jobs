# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/08_attention_cores.jobs

# Attention-aware cores (whole key/value bundles: a key/value head with the three query heads that share it, plus a
# quarter of the MLP blocks in every layer) at 25% per task, StackCube consolidated for 6000 or 24000 updates, a
# low-rank attention branch for task 3 (rank 16 or 64); a learned interface adapter for task 3; a repeat of the 25%
# chain on a second GPU type; the cut-out (sliced) sub-networks against PackNet; repeated test evaluations.

