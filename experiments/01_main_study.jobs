# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/01_main_study.jobs

# Stage A (PushCube, 200 demos, 8000 updates), intervention importance, then 500 more PushCube updates: plain (A_plus, start of seqft/ER/EWC) or gated consolidation into a random 25% core
s0_A|-|training/train_stage.py --method seqft --task PushCube-v1 --steps 8000 --eval-every 2000 --seed 0 --final-split test --final-episodes 100 --eval-init --out $CVLA_RUNS/final/s0/A
s1_A|-|training/train_stage.py --method seqft --task PushCube-v1 --steps 8000 --eval-every 2000 --seed 1 --final-split test --final-episodes 100  --out $CVLA_RUNS/final/s1/A
