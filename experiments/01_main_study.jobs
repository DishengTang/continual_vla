s0_A_plus|$CVLA_RUNS/final/s0/A/stage.json|training/train_stage.py --method seqft --task PushCube-v1 --init $CVLA_RUNS/final/s0/A --seed 0 --steps 500 --warmup 50 --eval-every 100000 --final-tasks PushCube-v1 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/A_plus
s0_A_core_rand|$CVLA_RUNS/final/s0/A/ablation_scores.json|training/train_stage.py --method consolidate_gate --task PushCube-v1 --init $CVLA_RUNS/final/s0/A --core-from $CVLA_RUNS/final/s0/A --core-selection random --seed 0 --eval-init --steps 500 --warmup 50 --eval-every 100000 --final-tasks PushCube-v1 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s0/A_core_rand
