s1_A_plus|$CVLA_RUNS/final/s1/A/stage.json|training/train_stage.py --method seqft --task PushCube-v1 --init $CVLA_RUNS/final/s1/A --seed 1 --steps 500 --warmup 50 --eval-every 100000 --final-tasks PushCube-v1 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/A_plus
s1_A_core_rand|$CVLA_RUNS/final/s1/A/ablation_scores.json|training/train_stage.py --method consolidate_gate --task PushCube-v1 --init $CVLA_RUNS/final/s1/A --core-from $CVLA_RUNS/final/s1/A --core-selection random --seed 1 --eval-init --steps 500 --warmup 50 --eval-every 100000 --final-tasks PushCube-v1 --final-split test --final-episodes 100 --out $CVLA_RUNS/final/s1/A_core_rand
