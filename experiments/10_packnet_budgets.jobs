# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/10_packnet_budgets.jobs

# PackNet at other budgets: 25% per task with 24000 StackCube retraining updates; task 3 trained with every weight
# unfrozen; 10% and 5% per task with 500 PushCube retraining updates; 5% and 2.5% per task matched to the gate (2000
# PushCube retraining updates, state/action/time projections kept whole like the gate's), and the two-task scores of
# the matched 5% run.

