# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/14_rollout_videos.jobs

# Rollout videos on the project page: every test episode of seed 0 recorded for the two-task and three-task stages
# shown (fine-tuning, ER-50, PackNet at 5% per task, consolidate-and-gate with 25% and 5% cores).

