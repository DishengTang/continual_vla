# One job per line:  <name>|<prerequisite (path that must exist) or ->|<arguments for python>
# Run from the repository root:  source scripts/env.sh && bash experiments/run_jobs.sh experiments/11_over_capacity.jobs

# Beyond capacity: two 50% shares fill the network before task 3. The gate: nothing released, or 20/50% of each
